{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citadel-lyra-local",
  "main": "workers/app.ts",
  "compatibility_date": "2025-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "build/client",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "APP_ENV": "local",
    "LOCAL_AUTH_BYPASS": "true",
    "MOCK_AI": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyra-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "lyra-local-reports",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ConversationAgent",
        "class_name": "ConversationAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationAgent"],
    },
  ],
  "workflows": [
    {
      "binding": "RESEARCH",
      "name": "lyra-local-research",
      "class_name": "ResearchWorkflow",
    },
  ],
  "env": {
    "staging": {
      "name": "citadel-lyra-staging",
      "vars": {
        "APP_ENV": "staging",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOWED_EMAIL": "",
        "AI_GATEWAY_ACCOUNT_ID": "",
        "AI_GATEWAY_ID": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lyra-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "REPORTS",
          "bucket_name": "lyra-staging-reports",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ConversationAgent",
            "class_name": "ConversationAgent",
          },
        ],
      },
      "workflows": [
        {
          "binding": "RESEARCH",
          "name": "lyra-staging-research",
          "class_name": "ResearchWorkflow",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "RUN_DISPATCH",
            "queue": "lyra-staging-dispatch",
          },
        ],
        "consumers": [
          {
            "queue": "lyra-staging-dispatch",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "retry_delay": 5,
          },
        ],
      },
    },
    "production": {
      "name": "lyra",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "ACCESS_TEAM_DOMAIN": "dsilverdi.cloudflareaccess.com",
        "ACCESS_AUD": "d3aa006b39496af3da114a9a4b1a6bd4f1cdaa2268dfc2fd15eaa230224addb1",
        "ALLOWED_EMAIL": "dsilverdi@gmail.com",
        "AI_GATEWAY_ACCOUNT_ID": "3b1a88ed9e2d5d5c1012dfd7ea934e6d",
        "AI_GATEWAY_ID": "lyra-production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lyra-production",
          "database_id": "cafb5347-141e-449d-b727-aab708cd3b57",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "REPORTS",
          "bucket_name": "lyra-production-reports",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ConversationAgent",
            "class_name": "ConversationAgent",
          },
        ],
      },
      "workflows": [
        {
          "binding": "RESEARCH",
          "name": "lyra-production-research",
          "class_name": "ResearchWorkflow",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "RUN_DISPATCH",
            "queue": "lyra-production-dispatch",
          },
        ],
        "consumers": [
          {
            "queue": "lyra-production-dispatch",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "retry_delay": 5,
          },
        ],
      },
    },
  },
  "queues": {
    "producers": [
      {
        "binding": "RUN_DISPATCH",
        "queue": "lyra-local-dispatch",
      },
    ],
    "consumers": [
      {
        "queue": "lyra-local-dispatch",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 5,
      },
    ],
  },
}
